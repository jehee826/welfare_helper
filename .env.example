# Supabase는 Transaction pooler 접속 문자열을 사용한다.
DATABASE_URL=

# 로컬 PostgreSQL은 DATABASE_URL을 비우고 아래 값을 사용한다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM=gemma3:4b
OLLAMA_EMBED=bge-m3
# 기존 vector(1024) 스키마와 같은 차원의 모델만 사용할 수 있다.
EMBED_DIM=1024
OLLAMA_TIMEOUT=120
RETRIEVE_TOP_N=12
MIN_DENSE_SIM=0.52
# INT8 ONNX 리랭커는 미리 다운로드한 로컬 캐시에서만 실행한다.
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b
RERANK_CACHE_DIR=.reranker_cache
RERANK_MAX_LENGTH=512
RERANK_THREADS=2
# sigmoid 관련성 점수이며 자격·사실 정확도의 확률이 아니다.
MIN_RERANK_SCORE=0.5
