# 저장소 루트 .env의 예시. 실제 비밀값은 Git·로그·VITE_*에 넣지 않는다.
# 1. 현재 구성: Supabase + Docker 백엔드/Ollama + 호스트 Vite
# DATABASE_URL은 실제 Connect의 Session pooler 주소를 사용한다. 호스트·사용자명을 추측하지 않는다.
# 예: postgresql://postgres.<project-ref>@<pooler-host>:5432/postgres
# 비밀번호는 URI에 조합하지 않고 DB 드라이버의 별도 password 인자로 전달한다.
DATABASE_URL=
DATABASE_PASSWORD=
# Compose는 아래 두 값을 supabase / false로 고정한다. CSV 자동 적재는 지원하지 않는다.
DATABASE_MODE=supabase
INGEST_ON_STARTUP=false

# 현재 노트북 모델. Compose의 Ollama 준비 목록과 백엔드에 같은 이름이 전달된다.
OLLAMA_LLM=qwen2.5:1.5b-instruct
OLLAMA_EMBED=bge-m3
EMBED_DIM=1024
# 느린 로컬 생성도 기다릴 수 있도록 요청별 모델 대기 예산을 초 단위로 지정한다.
OLLAMA_TIMEOUT=600
LLM_NUM_THREAD=2
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=512
LLM_TEMPERATURE=0
# 호스트 직접 실행 주소. Compose에서는 http://ollama:11434로 덮어쓴다.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 고정 리랭커. 캐시는 Compose가 /app/.reranker_cache로 마운트한다.
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b
RERANK_CACHE_DIR=.reranker_cache
RERANK_MAX_LENGTH=512
RERANK_THREADS=2
RETRIEVE_TOP_N=12
DENSE_TOP_K=30
KEYWORD_TOP_K=30
CORE_EVIDENCE_K=6

# Vite는 저장소 루트 환경파일을 사용하며 VITE_ 접두사 값만 브라우저에 노출한다.
# 로컬은 빈 값 + /api 프록시. 별도 서버 연결 시 /api를 제외한 HTTPS 기본 주소를 넣고 재빌드한다.
# 외부 백엔드의 인증·CORS·공개 접근 설정은 별도이며 이 변수만으로 연결되지 않는다.
VITE_API_BASE_URL=
# /admin의 데모 UI 잠금용. 브라우저 번들에 포함되므로 실제 관리자 인증/비밀번호로 사용하지 않는다.
VITE_ADMIN_DEMO_KEY=

# 2. 문서 처리: Compose는 두 값을 true로 고정한다. 공개 환경에서 LOCAL_MODE를 켜지 않는다.
# 아래 false는 Docker 밖 직접 실행에서 명시적으로 활성화하기 전의 안전한 기본값이다.
DOCUMENTS_ENABLED=false
DOCUMENTS_LOCAL_MODE=false
DOCUMENTS_MAX_FILE_MB=20
DOCUMENTS_MAX_PAGES=100
DOCUMENTS_MAX_CHARACTERS=500000
DOCUMENTS_MAX_CHUNKS=2000
DOCUMENTS_PARSE_TIMEOUT=300
DOCUMENTS_INDEX_TIMEOUT=600
DOCUMENTS_DOWNLOAD_TIMEOUT=7200
DOCUMENTS_POLL_SECONDS=10
DOCUMENTS_LEASE_SECONDS=90
DOCLING_OCR=false
# Compose에서 /app/.docling_cache로 고정하며 기존 모델 볼륨을 재사용한다.
DOCLING_CACHE_DIR=/app/.docling_cache
DOCUMENT_WORKER_CPUS=2
DOCUMENT_WORKER_MEMORY=4g

# 3. 선택 기능: 현재 로컬 PDF 채팅에는 필요하지 않다.
# 공식 상세 조회 유틸리티 전용. 키가 없어도 기존 문서 검색은 가능하다.
BOKJIRO_SERVICE_KEY=
BOKJIRO_DETAIL_URL=https://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfaredetailedV001
BOKJIRO_TIMEOUT=15
# 공개 문서 관리자 인증/Storage용 서버 전용 값. VITE_ 접두사를 붙이지 않는다.
# 프런트 로그인/JWT 연동은 별도 작업이다. Vercel 프런트 프로젝트에는 주입하지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DOCUMENTS_BUCKET=document-originals
# 기존 복지 상담·진단 경로 설정. 현재 기본 PDF RAG의 점수 컷오프에는 적용되지 않는다.
MIN_DENSE_SIM=0.52
MIN_RERANK_SCORE=0.5
RAG_DIAGNOSTICS_ENABLED=false
RAG_DIAGNOSTICS_TOKEN=

# 4. 별도 로컬 PostgreSQL 개발 전용. Supabase 구성에서는 불필요하다.
# LOCAL_DB_*는 읽지 않는다. 아래 DB_*가 실제 설정 이름이다.
# 호스트 직접 실행 시 DATABASE_URL을 비우고 DATABASE_MODE=local로 사용한다.
# 기본 Compose는 Supabase를 강제하므로 --profile local만으로 백엔드 DB가 전환되지 않는다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
