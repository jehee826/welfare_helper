# 상주 백엔드는 실제 Connect 화면의 Session pooler를 검토한다. 접속값은 추측하지 않는다.
# DATABASE_URL => 사용할 DB의 CONNECT에서 Transaction pooler URL
# DATABASE_PASSWORD => 위 URL의 :[YOUR PASSWORD] 대신들어가는 값이고 여기서 따로쓰고 compose에서 조합해서 사용한다
DATABASE_URL=
DATABASE_PASSWORD=
DATABASE_MODE=auto
INGEST_ON_STARTUP=true

# 로컬 PostgreSQL은 DATABASE_URL을 비우고 아래 값을 사용한다.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=your_db_user
LOCAL_DB_PASSWORD=your_db_password
LOCAL_DB_NAME=your_db_name
# 올라마 컨테이너
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 이 값 하나를 바꾸면 백엔드 선택 모델과 Ollama 준비 목록에 함께 적용된다.
# notebook의 Ollama 메모리 상한은 2GB이며 큰 모델은 실행하지 못할 수 있다.
OLLAMA_LLM=gemma3:4b
OLLAMA_EMBED=bge-m3
# 기존 vector(1024) 스키마와 같은 차원의 모델만 사용할 수 있다.
EMBED_DIM=1024
OLLAMA_TIMEOUT=120
LLM_NUM_THREAD=2
RETRIEVE_TOP_N=12
MIN_DENSE_SIM=0.52
# INT8 ONNX 리랭커는 미리 다운로드한 로컬 캐시에서만 실행한다.
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANK_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b
RERANK_CACHE_DIR=.reranker_cache
RERANK_MAX_LENGTH=512
RERANK_THREADS=2
# sigmoid 관련성 점수이며 자격·사실 정확도의 확률이 아니다.
MIN_RERANK_SCORE=0.5
# 공공데이터포털 중앙부처복지서비스 활용신청 후 런타임에 주입한다.
BOKJIRO_SERVICE_KEY=
BOKJIRO_DETAIL_URL=https://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfaredetailedV001
BOKJIRO_TIMEOUT=15
