# 환경변수 제외
.env
.venv/
.vercel/

# 빌드시 자동생성되며 무거운 데이터 제외
# 로컬 볼륨 데이터
ollama_data/
postgres_data/

# 파이썬 컴파일결과 제외
**/__pycache__/
**/*.pyc

# 로컬 ERD 설계 파일
/복지챗봇.erd

# 로컬 개발·테스트 환경
.pytest_cache/
.reranker_cache/

.CLAUDE.md

# 개인 지침과 로컬 스킬
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/

# 파이썬 패키지 빌드 산출물 제외
*.egg-info/

.vercel
.env*

# 현재 공유 설계만 명시적으로 추적
/docs/design/*
!/docs/design/architecture.md
!/docs/design/rag.md
!/docs/design/extension.md
!/docs/design/admin.md
!/docs/design/database/
/docs/design/database/*
!/docs/design/database/복지챗봇.erd

# 협업·실행 계획은 확정된 공개 범위가 정해질 때까지 로컬 보관
/docs/plan/*

# 과거 문서는 기본 로컬 보관, 기존 공유 문서의 이동본만 추적
/docs/archive/*
!/docs/archive/README.md
!/docs/archive/designs/
/docs/archive/designs/*
!/docs/archive/designs/rag-accuracy-design.md
!/docs/archive/designs/welfare-rag-pipeline-design.md
!/docs/archive/designs/welfare-rag-features.md
!/docs/archive/designs/implementation-gap-analysis.md
!/docs/archive/designs/specs/
/docs/archive/designs/specs/*
!/docs/archive/designs/specs/2026-10-21-welfare-mockup-design.md
!/docs/archive/designs/specs/2026-10-21-welfare-rag-mvp-design.md
!/docs/archive/designs/database/
/docs/archive/designs/database/*
!/docs/archive/designs/database/복지챗봇-mockup.erd
!/docs/archive/plans/
/docs/archive/plans/*
!/docs/archive/plans/roadmap-p0-solutions.md

# 개인 수동 평가·결과·개발일지·인계
/docs/tests/
/docs/log/

# Word 원본은 로컬 보존
*.[dD][oO][cC]
*.[dD][oO][cC][xX]

# ec2 키페어 제외
welfare_helper__key.pem
/.local/extension-connection.json
/.local/.gyeote-connection-*
/.local/extension-packages/
/.local/t5_*.py
/.local/t5-*.json
/.local/t5-*.jsonl
/.local/t5-*.zip
/.local/t10c-*/

# 문서 재정리 복구본·원문 대조 결과는 개인 기록
/.local/docs-cleanup-*/
/.local/docs-structure-*/
