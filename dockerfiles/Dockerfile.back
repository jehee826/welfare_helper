FROM python:3.12-slim

WORKDIR /app

COPY requirements/locks/build-py312-linux.txt requirements/locks/backend-py312-linux.txt ./requirements/locks/
RUN pip install --no-cache-dir --require-hashes -r requirements/locks/build-py312-linux.txt \
    && pip install --no-cache-dir --require-hashes --no-build-isolation -r requirements/locks/backend-py312-linux.txt

COPY BackEnd/ ./BackEnd/

EXPOSE 8000

CMD ["python", "-m", "BackEnd.startup"]
