FROM python:3.12-slim
WORKDIR /app
ENV PIP_DEFAULT_TIMEOUT=300 PIP_RETRIES=10
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 tesseract-ocr tesseract-ocr-kor \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/locks/build-py312-linux.txt requirements/locks/worker-py312-linux.txt ./requirements/locks/
RUN --mount=type=cache,target=/root/.cache/pip pip install --require-hashes -r requirements/locks/build-py312-linux.txt \
    && pip install --require-hashes --no-build-isolation -r requirements/locks/worker-py312-linux.txt
COPY BackEnd/ ./BackEnd/
ENV HF_HOME=/app/.docling_cache/huggingface \
    DOCLING_SECURITY_REFUSE_UNPINNED_REMOTE_CODE=1
CMD ["python", "-m", "BackEnd.documents.worker"]
